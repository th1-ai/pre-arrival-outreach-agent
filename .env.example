# Pre-Arrival Outreach Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# The skill itself does not read this file. It reads the placeholder
# values you set in .claude/skills/pre-arrival-outreach/SKILL.md (same names
# as below). Use `.env` as the one place your own tool scripts read their
# settings from, and add your PMS / email credentials here under whatever
# variable names those scripts expect.

# ============================================================
# Email accounts the skill drafts and sends from
# ============================================================
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI wrapper
# ============================================================
EMAIL_CLI="gws"

# ============================================================
# PMS reservation lookup (confirms a booking is still active)
# ============================================================
PMS_LOOKUP_TOOL="tools/lookup_guest.py"

# ============================================================
# Pre-arrival scanner
# ============================================================
# Tool that returns upcoming guests in the outreach window
# (default: premium rooms checking in 7-21 days from today).
# Output should be JSON for easy consumption by the skill.
PRE_ARRIVAL_TOOL="tools/pre_arrival_scan.py"

# ============================================================
# Draft helper
# ============================================================
DRAFT_NEW_TOOL="tools/create_draft_email.py"

# ============================================================
# Concierge form URL (whole-property renters only, optional)
# ============================================================
CONCIERGE_FORM_URL=""

# ============================================================
# Operator identity (used in sign-offs and message body)
# ============================================================
OPERATOR_NAME=""
HOTEL_NAME=""
NEAREST_AIRPORT=""
LOCAL_RESTAURANT=""
