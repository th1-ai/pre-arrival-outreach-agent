# Pre-Arrival Outreach Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Email accounts the agent can read and draft from
# ============================================================
# Referenced inside .claude/skills/pre-arrival-outreach/SKILL.md
# via the {{INBOX_*}} placeholders.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
EMAIL_CLI="gws"

# ============================================================
# PMS integration
# ============================================================
PMS_LOOKUP_TOOL="tools/lookup_guest.py"

# ============================================================
# Pre-arrival scanner
# ============================================================
# Tool that returns upcoming guests in the outreach window
# (default: premium rooms checking in 7-21 days from today).
# Output should be JSON for easy consumption by the skill.

PRE_ARRIVAL_TOOL="tools/pre_arrival_scan.py"

# ============================================================
# Draft helper
# ============================================================
DRAFT_NEW_TOOL="tools/create_draft_email.py"

# ============================================================
# Concierge form URL (whole-property renters only)
# ============================================================
CONCIERGE_FORM_URL=""

# ============================================================
# Operator identity (used in sign-offs and message body)
# ============================================================
OPERATOR_NAME=""
HOTEL_NAME=""
NEAREST_AIRPORT=""
LOCAL_RESTAURANT=""
